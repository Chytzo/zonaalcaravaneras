---
import Base from '../layouts/Base.astro';
import comercios from '../data/comercios.json';
import { slugificar } from '../utils/slug.js';
import { enlaceWhatsapp } from '../config.js';

export function getStaticPaths() {
  return comercios.map((comercio) => ({
    params: { slug: comercio.slug },
    props: { comercio },
  }));
}

const { comercio } = Astro.props;
const url = new URL(`/${comercio.slug}/`, Astro.site).toString();

// og:image: la foto del comercio si existe; si no, la imagen generada por
// categoría (public/og/*.png). Así toda ficha comparte bien en WhatsApp.
const ogImagen = comercio.fotos?.length
  ? comercio.fotos[0]
  : `/og/${slugificar(comercio.categoria)}.png`;

// Mapa categoría → tipo schema.org. Convierte cada ficha de "LocalBusiness
// genérico" a su tipo real de negocio: es lo que hace que Google y los LLMs
// (ChatGPT/Perplexity/Gemini) reconozcan la ficha como una entidad concreta
// y la citen para su categoría ("dónde comer", "peluquería en ...", etc.).
const TIPO = {
  'Alimentación': 'GroceryStore',
  'Bares y cafés': 'BarOrPub',
  'Bazares': 'Store',
  'Belleza': 'BeautySalon',
  'Deporte y ocio': 'SportsActivityLocation',
  'Electrónica': 'ElectronicsStore',
  'Hogar y reformas': 'HomeGoodsStore',
  'Hogar y decoración': 'HomeGoodsStore',
  'Mascotas': 'PetStore',
  'Moda': 'ClothingStore',
  'Motor': 'AutoDealer',
  'Restaurantes': 'Restaurant',
  'Salud': 'MedicalBusiness',
  'Servicios': 'ProfessionalService',
};
const tipo = TIPO[comercio.categoria] || 'LocalBusiness';
const CON_COCINA = new Set(['Restaurant', 'BarOrPub', 'CafeOrCoffeeShop']);

// Etiqueta legible en singular de la categoría (para la frase answer-first).
const CAT_LABEL = {
  'Alimentación': 'tienda de alimentación',
  'Bares y cafés': 'bar o cafetería',
  'Bazares': 'bazar',
  'Belleza': 'establecimiento de belleza',
  'Deporte y ocio': 'tienda de deporte y ocio',
  'Electrónica': 'tienda de electrónica',
  'Hogar y reformas': 'tienda de hogar y reformas',
  'Hogar y decoración': 'tienda de artículos para el hogar y decoración',
  'Mascotas': 'tienda de mascotas',
  'Moda': 'tienda de moda',
  'Motor': 'establecimiento de automoción',
  'Restaurantes': 'restaurante',
  'Salud': 'establecimiento de salud',
  'Servicios': 'servicio',
};
const catLabel = CAT_LABEL[comercio.categoria] || comercio.categoria.toLowerCase();

// JSON-LD: es lo que hace que Google entienda cada ficha como un negocio real
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': tipo,
  name: comercio.nombre,
  description: comercio.descripcion || undefined,
  url,
  telephone: comercio.telefono || undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: comercio.calle,
    addressLocality: 'Las Palmas de Gran Canaria',
    postalCode: comercio.cp,
    addressRegion: 'Las Palmas',
    addressCountry: 'ES',
  },
  containedInPlace: {
    '@type': 'Place',
    name: 'Las Alcaravaneras',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Las Palmas de Gran Canaria',
      postalCode: '35006',
      addressRegion: 'Las Palmas',
      addressCountry: 'ES',
    },
  },
  openingHours: comercio.horarioSchema?.length ? comercio.horarioSchema : undefined,
  ...(comercio.lat != null && comercio.lon != null
    ? { geo: { '@type': 'GeoCoordinates', latitude: comercio.lat, longitude: comercio.lon } }
    : {}),
  sameAs: comercio.web ? [comercio.web] : undefined,
  image: comercio.fotos?.length
    ? comercio.fotos.map((f) => new URL(f, Astro.site).toString())
    : undefined,
  ...(CON_COCINA.has(tipo) && comercio.rasgos?.length
    ? { servesCuisine: comercio.rasgos }
    : {}),
};

// Frase answer-first (visible + sumario): responde en una línea a la consulta
// local de la categoría, con solo datos verificados. Los LLMs extraen este
// formato como cita directa.
const lineaGeo = `${comercio.nombre}, ${catLabel} en ${
  comercio.calle
}, barrio de Alcaravaneras (Las Palmas de Gran Canaria)${
  comercio.telefono ? `, teléfono ${comercio.telefono}` : ''
}${comercio.horario ? `, horario ${comercio.horario}` : ''}.`;

const telHref = comercio.telefono?.replace(/\s/g, '');
const waHref = comercio.whatsapp?.replace(/[^\d]/g, '');

// Contacto con la guía, con el nombre del negocio ya escrito en el mensaje
const waGuia = enlaceWhatsapp(
  `Hola, soy de ${comercio.nombre}. Quiero cambiar algo de mi ficha en la guía.`
);

// Migas de pan: ayudan a buscadores y asistentes a situar la página
// dentro de la jerarquía del sitio.
const migas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Comercios de Alcaravaneras',
      item: 'https://zonaalcaravaneras.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: comercio.categoria,
      item: `https://zonaalcaravaneras.com/categoria/${slugificar(comercio.categoria)}/`,
    },
    { '@type': 'ListItem', position: 3, name: comercio.nombre },
  ],
};
---

<Base
  titulo={`${comercio.nombre} — ${comercio.categoria} en Alcaravaneras`}
  descripcion={lineaGeo}
  imagen={ogImagen}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify([jsonLd, migas])}
  />

  <section class="cinta" slot="portada">
    <div class="contenedor">
      <span class="etiqueta-cat">{comercio.categoria}</span>
      <h1>{comercio.nombre}</h1>
      <p class="geo-intro">{lineaGeo}</p>
      {comercio.descripcion && <p>{comercio.descripcion}</p>}
      <div class="acciones">
        {comercio.telefono && (
          <a class="boton" href={`tel:${telHref}`}>
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 3 5.2 2 2 0 0 1 5 3h1.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            </svg>
            Llamar
          </a>
        )}
        {comercio.whatsapp && (
          <a class="boton fantasma" href={`https://wa.me/${waHref}`} rel="noopener">WhatsApp</a>
        )}
        {comercio.maps && (
          <a class="boton fantasma" href={comercio.maps} rel="noopener">Cómo llegar</a>
        )}
      </div>
    </div>
  </section>

  <div class="contenedor">
    <div class="ficha-imagen">
      {comercio.fotos?.length > 0 ? (
        <img src={comercio.fotos[0]} alt={`Local de ${comercio.nombre}`} loading="lazy" />
      ) : (
        <div class="ficha-imagen--vacia">
          <span class="inicial">{comercio.nombre.trim().charAt(0).toUpperCase()}</span>
          <p>
            Sin foto todavía. Si es tu negocio,
            <a href={waGuia} rel="noopener"> mándanos una por WhatsApp</a> y la ponemos.
          </p>
        </div>
      )}
    </div>

    {comercio.fotos?.length > 1 && (
      <div class="galeria">
        {comercio.fotos.slice(1).map((foto) => (
          <img src={foto} alt={`Local de ${comercio.nombre}`} loading="lazy" />
        ))}
      </div>
    )}

    <div class="ficha-cols">
      <div class="tarjeta-datos">
        <ul class="datos">
          <li>
            <span class="clave">Dirección</span>
            <span>{comercio.calle}<br />{comercio.cp} Las Palmas de Gran Canaria</span>
          </li>
          {comercio.horario && (
            <li><span class="clave">Horario</span><span>{comercio.horario}</span></li>
          )}
          {comercio.telefono && (
            <li>
              <span class="clave">Teléfono</span>
              <span><a href={`tel:${telHref}`}>{comercio.telefono}</a></span>
            </li>
          )}
          {comercio.web && (
            <li>
              <span class="clave">Web</span>
              <span><a href={comercio.web} rel="noopener">{comercio.web}</a></span>
            </li>
          )}
          {comercio.email && (
            <li>
              <span class="clave">Correo</span>
              <span><a href={`mailto:${comercio.email}`}>{comercio.email}</a></span>
            </li>
          )}
          {comercio.rasgos?.length > 0 && (
            <li>
              <span class="clave">Detalles</span>
              <span class="rasgos">
                {comercio.rasgos.map((r) => <span class="rasgo">{r}</span>)}
              </span>
            </li>
          )}
        </ul>

        <div class="contacto-comercio">
          <h2>Contactar</h2>
          <div class="acciones">
            {comercio.telefono && (
              <a class="boton" href={`tel:${telHref}`}>Llamar</a>
            )}
            {comercio.whatsapp && (
              <a class="boton secundario" href={`https://wa.me/${waHref}`} rel="noopener">WhatsApp</a>
            )}
            {comercio.email && (
              <a class="boton secundario" href={`mailto:${comercio.email}`}>Correo</a>
            )}
            {comercio.web && (
              <a class="boton secundario" href={comercio.web} rel="noopener nofollow">Su web</a>
            )}
            {comercio.maps && (
              <a class="boton secundario" href={comercio.maps} rel="noopener">Cómo llegar</a>
            )}
          </div>
          {!comercio.telefono && !comercio.whatsapp && !comercio.email && !comercio.web && (
            <p class="sin-contacto">
              Todavía no tenemos forma de contacto de este negocio.
              <a href={waGuia} rel="noopener"> Si es el tuyo, dínoslo</a> y la añadimos hoy.
            </p>
          )}
        </div>

        {!comercio.telefono && !comercio.horario && (
          <p class="incompleta">
            Aún no tenemos teléfono ni horario de este negocio. Si es el tuyo,
            mándanos los datos y los ponemos hoy mismo.
          </p>
        )}
      </div>

      <div>
        <div class="aviso calma">
          ¿Eres el responsable de este negocio? Si hay algún dato mal, o prefieres que
          quitemos la ficha, <a href={waGuia} rel="noopener">escríbenos por WhatsApp</a>.
          Lo cambiamos el mismo día, sin coste y sin preguntas.
        </div>
        <p>
          <a href={`/categoria/${slugificar(comercio.categoria)}/`}>
            Ver más comercios de {comercio.categoria.toLowerCase()}
          </a><br />
          <a href="/">&larr; Todos los comercios del barrio</a>
        </p>
      </div>
    </div>
  </div>
</Base>
